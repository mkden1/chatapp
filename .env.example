# Copy to .env and set your own values. .env is gitignored.
DATABASE_URL=postgres://chatapp:change_me@localhost:5540/chatapp
GIPHY_API_KEY=your_giphy_api_key
PORT=3000

# Optional: which server the Electron desktop client connects to. Defaults to
# ws://localhost:3000 if unset (matching PORT above). Set this to point the
# desktop client at a deployed server instead.
# DESKTOP_SERVER_URL=wss://your-deployed-server.example.com

# Only used by docker-compose.yml, for a local Postgres. Must match the
# credentials and port embedded in DATABASE_URL above.
POSTGRES_DB=chatapp
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5540
